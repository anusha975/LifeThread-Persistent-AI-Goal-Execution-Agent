# ==============================================================================
# LifeThread Platform - Environment Configuration Template
# Copy this file to .env and customize for your local or production deployment.
# NEVER commit real credentials or secrets to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
APP_NAME=LifeThread

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# PostgreSQL Database Configuration
POSTGRES_USER=lifethread_user
POSTGRES_PASSWORD=lifethread_password_dev_only
POSTGRES_DB=lifethread_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://lifethread_user:lifethread_password_dev_only@localhost:5432/lifethread_db

# Database Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
DB_ECHO=false

# Redis Caching Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Authentication & JWT Configuration
JWT_SECRET_KEY=dev_secret_key_change_in_production_min_32_bytes_long!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# MCP (Model Context Protocol) Server Configuration
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8001
MCP_TRANSPORT=http

# AI Provider Configuration (Placeholders for future modules - never commit live API keys)
LLM_PROVIDER=openai
OPENAI_API_KEY=CHANGEME_IN_PRODUCTION
ANTHROPIC_API_KEY=CHANGEME_IN_PRODUCTION

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
